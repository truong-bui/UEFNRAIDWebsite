---
import { NAV, SITE } from "@lib/site";

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<header class="border-b border-ink-800 bg-ink-950/85 backdrop-blur sticky top-0 z-40">
  <div class="mx-auto max-w-6xl px-4 py-4 flex items-center justify-between gap-6">
    <a href="/" class="flex items-center gap-3 group">
      <img src="/assets/logo.svg" alt="" width="36" height="36" class="rounded" />
      <span class="font-bold text-lg tracking-tight text-ink-50 group-hover:text-brand-400 transition-colors">
        {SITE.name}
      </span>
    </a>

    <nav aria-label="Primary" class="hidden md:flex items-center gap-1 text-sm">
      {
        NAV.map((item) => {
          const active = path === item.href || (item.href !== "/" && path.startsWith(item.href));
          return (
            <a
              href={item.href}
              class:list={[
                "px-3 py-1.5 rounded-md transition-colors",
                active
                  ? "text-brand-400 bg-ink-800"
                  : "text-ink-300 hover:text-ink-50 hover:bg-ink-900",
              ]}
              aria-current={active ? "page" : undefined}
            >
              {item.label}
            </a>
          );
        })
      }
    </nav>

    <details class="md:hidden relative">
      <summary class="list-none cursor-pointer p-2 rounded hover:bg-ink-900" aria-label="Open menu">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="4" y1="6" x2="20" y2="6" />
          <line x1="4" y1="12" x2="20" y2="12" />
          <line x1="4" y1="18" x2="20" y2="18" />
        </svg>
      </summary>
      <nav
        aria-label="Mobile primary"
        class="absolute right-0 mt-2 w-56 bg-ink-900 border border-ink-800 rounded-lg p-2 shadow-xl"
      >
        {
          NAV.map((item) => (
            <a href={item.href} class="block px-3 py-2 rounded text-sm text-ink-200 hover:bg-ink-800">
              {item.label}
            </a>
          ))
        }
      </nav>
    </details>
  </div>
</header>
