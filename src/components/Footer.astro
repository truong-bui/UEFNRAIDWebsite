---
import { SITE, SOCIALS } from "@lib/site";
const year = new Date().getFullYear();
---

<footer class="border-t border-ink-800 mt-20 bg-ink-950">
  <div class="mx-auto max-w-6xl px-4 py-10 grid gap-8 md:grid-cols-3">
    <div>
      <div class="flex items-center gap-3 mb-3">
        <img src="/assets/logo.svg" alt="" width="32" height="32" />
        <span class="font-bold text-ink-50">{SITE.name}</span>
      </div>
      <p class="text-sm text-ink-400 max-w-xs">{SITE.tagline}</p>
    </div>

    <div>
      <h2 class="text-xs uppercase tracking-wider text-ink-400 mb-3">Explore</h2>
      <ul class="space-y-2 text-sm">
        <li><a href="/posts" class="text-ink-200 hover:text-brand-400">Dev Posts</a></li>
        <li><a href="/maps" class="text-ink-200 hover:text-brand-400">Maps</a></li>
        <li><a href="/weapons" class="text-ink-200 hover:text-brand-400">Weapons</a></li>
        <li><a href="/learn" class="text-ink-200 hover:text-brand-400">How to Play</a></li>
        <li><a href="/contact" class="text-ink-200 hover:text-brand-400">Contact</a></li>
      </ul>
    </div>

    <div>
      <h2 class="text-xs uppercase tracking-wider text-ink-400 mb-3">Community</h2>
      <ul class="space-y-2 text-sm">
        {
          SOCIALS.map((s) => (
            <li>
              <a
                href={s.href}
                class="text-ink-200 hover:text-brand-400"
                target="_blank"
                rel="noopener noreferrer"
              >
                {s.name}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="border-t border-ink-800 px-4 py-5 text-xs text-ink-500 text-center">
    &copy; {year} {SITE.name}. Not affiliated with Epic Games. Fortnite and UEFN are trademarks of their respective owners.
  </div>
</footer>
