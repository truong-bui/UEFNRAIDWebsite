---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
   imagePath: string;
   altText: string;
   name: string;
   width: number;
   height: number;
   minRP?: string;
   maxRP?: string;
}

const { imagePath, altText, name, width, height, minRP, maxRP } = Astro.props;
const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/icons/*/*.{jpeg,jpg,png,gif}')
if (!images[imagePath]) throw new Error(`"${imagePath}" does not exist in glob: "/src/assets/images/icons/*/*.{jpeg,jpg,png,gif}"`);
---

<div style="text-align: center">       
    <Image src={images[imagePath]()} alt={altText} width={width} height={height}/>
    <b>{name}</b>
    {minRP && maxRP ? <p>{minRP} - {maxRP}</p> : ""}
</div>