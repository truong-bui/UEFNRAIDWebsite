---
/**
 * Gallery — embeddable image/video grid for posts and map articles.
 * Image items open in a fullscreen lightbox on click.
 *
 * Use inside an MDX post:
 *
 *   import Gallery from "@components/Gallery.astro";
 *   import shot1 from "../../assets/images/screenshots/market/HighresScreenshot00007.png";
 *
 *   <Gallery
 *     items={[
 *       { src: shot1, alt: "Topdown of Market", caption: "Topdown view" },
 *       { src: "/videos/bomb-planted.webm", kind: "video", poster: shot1, alt: "Bomb plant" },
 *     ]}
 *     columns={3}
 *   />
 */
import { Image } from "astro:assets";

export interface GalleryItem {
  src: ImageMetadata | string;
  alt: string;
  caption?: string;
  kind?: "image" | "video";
  poster?: ImageMetadata | string;
}

interface Props {
  items: GalleryItem[];
  columns?: 2 | 3 | 4;
  aspect?: "square" | "video";
}

const { items, columns = 3, aspect = "video" } = Astro.props;

const gridCols: Record<number, string> = {
  2: "grid-cols-1 sm:grid-cols-2",
  3: "grid-cols-2 md:grid-cols-3",
  4: "grid-cols-2 md:grid-cols-4",
};

const aspectClass = aspect === "square" ? "aspect-square" : "aspect-video";

function isImageMeta(s: ImageMetadata | string): s is ImageMetadata {
  return typeof s !== "string";
}

// Resolve the URL we hand to the lightbox — Astro hashes the imported asset path.
function fullSrc(s: ImageMetadata | string): string {
  return isImageMeta(s) ? s.src : s;
}
---

<figure class="not-prose my-8 raid-gallery" data-gallery>
  <ul class:list={["grid gap-3", gridCols[columns]]}>
    {
      items.map((item, i) => (
        <li class="group relative overflow-hidden rounded-lg border border-ink-800 bg-ink-900">
          <div class={`${aspectClass} bg-ink-950/60 overflow-hidden`}>
            {item.kind === "video" ? (
              <video
                class="w-full h-full object-cover"
                src={typeof item.src === "string" ? item.src : undefined}
                poster={item.poster ? fullSrc(item.poster) : undefined}
                muted
                loop
                playsinline
                preload="metadata"
                onmouseover="this.play()"
                onmouseout="this.pause()"
                aria-label={item.alt}
              />
            ) : (
              <button
                type="button"
                class="block w-full h-full cursor-zoom-in"
                data-lightbox-trigger
                data-index={i}
                data-full={fullSrc(item.src)}
                data-alt={item.alt}
                data-caption={item.caption ?? ""}
                aria-label={`Open ${item.alt} fullscreen`}
              >
                {isImageMeta(item.src) ? (
                  <Image
                    src={item.src}
                    alt={item.alt}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    widths={[400, 800, 1200]}
                    sizes={`(max-width: 768px) 100vw, ${Math.floor(100 / columns)}vw`}
                  />
                ) : (
                  <img
                    src={item.src}
                    alt={item.alt}
                    loading="lazy"
                    decoding="async"
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  />
                )}
              </button>
            )}
          </div>
          {item.caption && item.caption.trim() !== "" && (
            <figcaption class="px-3 py-2 text-xs text-ink-300 bg-ink-900 border-t border-ink-800">
              {item.caption}
            </figcaption>
          )}
        </li>
      ))
    }
  </ul>
</figure>

{/* Lightbox overlay — singleton, lazily wired by the script below. */}
<div
  id="raid-lightbox"
  class="fixed inset-0 z-[100] hidden bg-ink-950/95 backdrop-blur-sm flex-col items-center justify-center"
  role="dialog"
  aria-modal="true"
  aria-label="Image viewer"
>
  <button
    type="button"
    data-lightbox-close
    class="absolute top-4 right-4 p-2 rounded-md bg-ink-900 hover:bg-ink-800 text-ink-100 border border-ink-700"
    aria-label="Close (Esc)"
  >
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <line x1="6" y1="6" x2="18" y2="18" />
      <line x1="6" y1="18" x2="18" y2="6" />
    </svg>
  </button>

  <button
    type="button"
    data-lightbox-prev
    class="absolute left-4 md:left-8 top-1/2 -translate-y-1/2 p-3 rounded-full bg-ink-900/80 hover:bg-ink-800 text-ink-100 border border-ink-700"
    aria-label="Previous image (←)"
  >
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <polyline points="15 18 9 12 15 6"></polyline>
    </svg>
  </button>

  <button
    type="button"
    data-lightbox-next
    class="absolute right-4 md:right-8 top-1/2 -translate-y-1/2 p-3 rounded-full bg-ink-900/80 hover:bg-ink-800 text-ink-100 border border-ink-700"
    aria-label="Next image (→)"
  >
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <polyline points="9 18 15 12 9 6"></polyline>
    </svg>
  </button>

  <img id="raid-lightbox-img" alt="" class="max-w-[92vw] max-h-[82vh] object-contain rounded shadow-2xl" />
  <p id="raid-lightbox-caption" class="mt-4 max-w-[80vw] text-center text-sm text-ink-300"></p>
  <p id="raid-lightbox-counter" class="mt-1 text-xs text-ink-500"></p>
</div>

<script>
  // Lightbox controller — singleton, wires every <Gallery> on the page.
  // Builds a flat list of all image items across galleries, indexed in DOM order.
  type LbItem = { src: string; alt: string; caption: string };

  const triggers = Array.from(
    document.querySelectorAll<HTMLButtonElement>("[data-lightbox-trigger]")
  );
  if (triggers.length > 0) {
    const items: LbItem[] = triggers.map((t) => ({
      src: t.dataset.full ?? "",
      alt: t.dataset.alt ?? "",
      caption: t.dataset.caption ?? "",
    }));

    const overlay = document.getElementById("raid-lightbox") as HTMLDivElement | null;
    const imgEl = document.getElementById("raid-lightbox-img") as HTMLImageElement | null;
    const capEl = document.getElementById("raid-lightbox-caption") as HTMLElement | null;
    const counterEl = document.getElementById("raid-lightbox-counter") as HTMLElement | null;
    const closeBtn = overlay?.querySelector<HTMLButtonElement>("[data-lightbox-close]");
    const prevBtn = overlay?.querySelector<HTMLButtonElement>("[data-lightbox-prev]");
    const nextBtn = overlay?.querySelector<HTMLButtonElement>("[data-lightbox-next]");

    if (overlay && imgEl && capEl && counterEl) {
      let current = 0;
      let prevFocus: HTMLElement | null = null;

      const show = (index: number) => {
        current = (index + items.length) % items.length;
        const it = items[current];
        imgEl.src = it.src;
        imgEl.alt = it.alt;
        capEl.textContent = it.caption;
        counterEl.textContent = `${current + 1} / ${items.length}`;
      };

      const open = (index: number) => {
        prevFocus = document.activeElement as HTMLElement;
        overlay.classList.remove("hidden");
        overlay.classList.add("flex");
        document.body.style.overflow = "hidden";
        show(index);
        closeBtn?.focus();
      };

      const close = () => {
        overlay.classList.add("hidden");
        overlay.classList.remove("flex");
        document.body.style.overflow = "";
        imgEl.src = "";
        prevFocus?.focus();
      };

      triggers.forEach((t, i) =>
        t.addEventListener("click", (e) => {
          e.preventDefault();
          open(i);
        })
      );
      closeBtn?.addEventListener("click", close);
      prevBtn?.addEventListener("click", () => show(current - 1));
      nextBtn?.addEventListener("click", () => show(current + 1));
      overlay.addEventListener("click", (e) => {
        if (e.target === overlay) close();
      });

      document.addEventListener("keydown", (e) => {
        if (overlay.classList.contains("hidden")) return;
        if (e.key === "Escape") close();
        else if (e.key === "ArrowLeft") show(current - 1);
        else if (e.key === "ArrowRight") show(current + 1);
      });

      // Touch swipe (mobile)
      let touchStartX = 0;
      overlay.addEventListener(
        "touchstart",
        (e) => {
          touchStartX = e.changedTouches[0].screenX;
        },
        { passive: true }
      );
      overlay.addEventListener(
        "touchend",
        (e) => {
          const dx = e.changedTouches[0].screenX - touchStartX;
          if (Math.abs(dx) > 50) show(current + (dx < 0 ? 1 : -1));
        },
        { passive: true }
      );
    }
  }
</script>
