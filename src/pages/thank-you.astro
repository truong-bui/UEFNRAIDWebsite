---
export const prerender = true;
import BaseLayout from "@layouts/BaseLayout.astro";
---

<BaseLayout
  title="Thanks"
  description="Your message has been received."
  noindex={true}
>
  <section class="mx-auto max-w-xl px-4 py-24 text-center">
    <h1 class="text-4xl font-extrabold text-ink-50">Got it.</h1>
    <p class="mt-3 text-ink-300">
      Thanks for reaching out — we'll get back to you within a few days.
    </p>
    <a
      href="/"
      class="inline-block mt-8 px-6 py-2.5 rounded-md bg-brand-500 hover:bg-brand-400 text-white font-semibold"
    >
      Back to home
    </a>
  </section>
</BaseLayout>
