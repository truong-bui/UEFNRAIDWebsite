---
export const prerender = true;
import { Image } from "astro:assets";
import BaseLayout from "@layouts/BaseLayout.astro";
import marketThumb from "@assets/images/thumbnails/market/RaidMarketThumbnail.png";
import marketMinimap from "@assets/images/minimap/market/T_MarketTopdownLayout.png";

// Curated map list. Add new maps here as they ship.
const maps = [
  {
    slug: "market",
    name: "Market",
    location: "Coastal town · daytime",
    sites: 2,
    thumbnail: marketThumb,
    minimap: marketMinimap,
    description:
      "Dense corridors of stalls and shopfronts. Two bomb sites at opposite ends, with a contested mid that controls rotation pace.",
  },
];

---

<BaseLayout
  title="Maps"
  description="Map roster for UEFN RAID. Layouts, callouts, and bomb-site overviews."
>
  <section class="mx-auto max-w-6xl px-4 py-16">
    <header class="mb-10">
      <h1 class="text-4xl font-extrabold text-ink-50">Maps</h1>
      <p class="mt-2 text-ink-300 max-w-2xl">
        Each RAID map is hand-built around two bomb sites and a contested mid. Read the layout, learn
        the callouts, then drop in.
      </p>
    </header>

    <div class="grid md:grid-cols-2 gap-6">
      {
        maps.map((m) => (
          <article class="rounded-lg border border-ink-800 bg-ink-900/40 overflow-hidden">
            <div class="aspect-video bg-ink-800">
              <Image
                src={m.thumbnail}
                alt={`${m.name} thumbnail`}
                class="w-full h-full object-cover"
                widths={[400, 800]}
                sizes="(max-width: 768px) 100vw, 50vw"
              />
            </div>
            <div class="p-5">
              <div class="flex items-baseline justify-between gap-3">
                <h2 class="text-xl font-bold text-ink-50">{m.name}</h2>
                <span class="text-xs text-ink-400">{m.sites} sites</span>
              </div>
              <p class="text-xs text-ink-500 mt-0.5">{m.location}</p>
              <p class="mt-3 text-sm text-ink-300">{m.description}</p>
              <details class="mt-4">
                <summary class="cursor-pointer text-sm text-brand-400 hover:underline">
                  View minimap
                </summary>
                <Image
                  src={m.minimap}
                  alt={`${m.name} minimap`}
                  class="mt-3 rounded-md border border-ink-800"
                  widths={[400, 800]}
                />
              </details>
            </div>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>
