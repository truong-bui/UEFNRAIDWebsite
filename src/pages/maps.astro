---
import MapsLayout from "@layouts/MapsLayout.astro";
import { Image } from 'astro:assets';
import RaidMarketThumbnail from "@assets/images/thumbnails/market/RaidMarketThumbnail.png";
const pageTitle = "Maps";
const allMaps = await Astro.glob("../pages/maps/*.md");
---
<MapsLayout title={pageTitle}>
  <ul>    
    {allMaps.map((map) => 
      <li>
          <h2><a href={map.url}>{map.frontmatter.title} </a></h2>
          <a href={map.url}><Image src={RaidMarketThumbnail} alt="RaidMarketThumbnail" width="1920" height="1080"/></a>
               
      </li>)}
  </ul>

</MapsLayout>
<!-- AstroPaper is a minimal, responsive and SEO-friendly Astro blog theme. I designed and crafted this based on [my personal blog](https://satnaing.dev/blog).

This theme is aimed to be accessible out of the box. Light and dark mode are supported by
default and additional color schemes can also be configured.

This theme is self-documented \_ which means articles/posts in this theme can also be considered as documentations. So, see the documentation for more info.

<div>
  <img src="/assets/dev.svg" class="sm:w-1/2 mx-auto" alt="coding dev illustration">
