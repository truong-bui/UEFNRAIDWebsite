---
export const prerender = true;
import BaseLayout from "@layouts/BaseLayout.astro";
---

<BaseLayout title="Not Found" description="That page doesn't exist." noindex={true}>
  <section class="mx-auto max-w-xl px-4 py-24 text-center">
    <p class="text-6xl font-extrabold text-brand-500">404</p>
    <h1 class="mt-4 text-3xl font-bold text-ink-50">Page not found</h1>
    <p class="mt-3 text-ink-300">The page you're looking for doesn't exist or moved.</p>
    <a
      href="/"
      class="inline-block mt-8 px-6 py-2.5 rounded-md bg-brand-500 hover:bg-brand-400 text-white font-semibold"
    >
      Back to home
    </a>
  </section>
</BaseLayout>
