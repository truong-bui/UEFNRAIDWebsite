---
export const prerender = true;
import BaseLayout from "@layouts/BaseLayout.astro";
import { FORMSPARK } from "@lib/site";
---

<BaseLayout
  title="Contact"
  description="Get in touch with the UEFN RAID team — bug reports, partnership inquiries, press."
>
  <section class="mx-auto max-w-2xl px-4 py-16">
    <header class="mb-8">
      <h1 class="text-4xl font-extrabold text-ink-50">Contact</h1>
      <p class="mt-2 text-ink-300">
        Bug reports, partnership inquiries, press, or just feedback. We read everything.
      </p>
    </header>

    <form
      id="contact-form"
      action={FORMSPARK.contact}
      method="post"
      class="space-y-5"
    >
      <input type="hidden" name="_redirect" value="/thank-you" />
      <input
        type="text"
        name="_gotcha"
        tabindex="-1"
        autocomplete="off"
        class="hidden"
        aria-hidden="true"
      />

      <div>
        <label for="name" class="block text-sm font-medium text-ink-200 mb-1.5">Name</label>
        <input
          id="name"
          type="text"
          name="name"
          required
          class="w-full px-4 py-2.5 rounded-md bg-ink-950 border border-ink-700 text-ink-100 focus:outline-none focus:border-brand-400"
        />
      </div>

      <div>
        <label for="email" class="block text-sm font-medium text-ink-200 mb-1.5">Email</label>
        <input
          id="email"
          type="email"
          name="email"
          required
          class="w-full px-4 py-2.5 rounded-md bg-ink-950 border border-ink-700 text-ink-100 focus:outline-none focus:border-brand-400"
        />
      </div>

      <div>
        <label for="topic" class="block text-sm font-medium text-ink-200 mb-1.5">Topic</label>
        <select
          id="topic"
          name="topic"
          class="w-full px-4 py-2.5 rounded-md bg-ink-950 border border-ink-700 text-ink-100 focus:outline-none focus:border-brand-400"
        >
          <option>Bug report</option>
          <option>Partnership</option>
          <option>Press</option>
          <option>Feedback</option>
          <option>Other</option>
        </select>
      </div>

      <div>
        <label for="message" class="block text-sm font-medium text-ink-200 mb-1.5">Message</label>
        <textarea
          id="message"
          name="message"
          required
          rows="6"
          class="w-full px-4 py-2.5 rounded-md bg-ink-950 border border-ink-700 text-ink-100 focus:outline-none focus:border-brand-400 resize-y"
        ></textarea>
      </div>

      <button
        type="submit"
        class="px-6 py-2.5 rounded-md bg-brand-500 hover:bg-brand-400 text-white font-semibold transition-colors"
      >
        Send
      </button>
    </form>
  </section>
</BaseLayout>

{/*
  If/when Cloudflare Turnstile is enabled on this Formspark form, switch from native HTML
  POST to JSON submission — Formspark's Turnstile-protected endpoint silently rejects multipart
  bodies and requires Content-Type: application/json. See PrintPartsLab's contact.astro for the
  canonical handler.
*/}
