---
import { SITE } from "@config";
import Maps from "@layouts/Maps.astro";
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import getSortedMaps from "@utils/getSortedMaps";

export const getStaticPaths = (async ({ paginate }) => {
  const maps = await getCollection("map", ({ data }) => !data.draft);
  return paginate(getSortedMaps(maps), { pageSize: SITE.postPerPage });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
---

<Maps {page} />
