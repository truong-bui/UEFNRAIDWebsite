---
export const prerender = true;
import { Image } from "astro:assets";
import { getCollection, render } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import { formatDate } from "@lib/utils";
import { SITE } from "@lib/site";

export async function getStaticPaths() {
  const maps = await getCollection("maps", ({ data }) => !data.draft);
  return maps.map((map) => ({
    params: { slug: map.id },
    props: { map },
  }));
}

const { map } = Astro.props;
const { Content } = await render(map);
const d = map.data;

const breadcrumbList = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: SITE.url },
    { "@type": "ListItem", position: 2, name: "Maps", item: `${SITE.url}/maps` },
    { "@type": "ListItem", position: 3, name: d.name },
  ],
};
---

<BaseLayout title={d.name} description={d.description} type="article">
  <article class="mx-auto max-w-4xl px-4 py-12">
    <nav class="text-xs text-ink-400 mb-6">
      <a href="/" class="hover:text-brand-400">Home</a> /
      <a href="/maps" class="hover:text-brand-400">Maps</a> /
      <span class="text-ink-300">{d.name}</span>
    </nav>

    <header class="mb-8">
      <p class="text-xs uppercase tracking-[0.2em] text-brand-400 mb-2">Map</p>
      <h1 class="text-4xl md:text-5xl font-extrabold text-ink-50 leading-tight">{d.name}</h1>
      <p class="mt-3 text-lg text-ink-300">{d.description}</p>

      <dl class="mt-6 grid grid-cols-2 sm:grid-cols-4 gap-4 text-sm">
        {
          d.location && (
            <div>
              <dt class="text-xs uppercase tracking-wider text-ink-500">Location</dt>
              <dd class="mt-1 text-ink-100">{d.location}</dd>
            </div>
          )
        }
        <div>
          <dt class="text-xs uppercase tracking-wider text-ink-500">Bomb sites</dt>
          <dd class="mt-1 text-ink-100">{d.sites}</dd>
        </div>
        <div>
          <dt class="text-xs uppercase tracking-wider text-ink-500">Modes</dt>
          <dd class="mt-1 text-ink-100">{d.modes.join(", ")}</dd>
        </div>
        {
          d.releaseDate && (
            <div>
              <dt class="text-xs uppercase tracking-wider text-ink-500">Released</dt>
              <dd class="mt-1 text-ink-100">{formatDate(d.releaseDate)}</dd>
            </div>
          )
        }
      </dl>
    </header>

    <Image
      src={d.thumbnail}
      alt={d.thumbnailAlt}
      class="rounded-lg w-full mb-8 border border-ink-800"
      widths={[600, 1200, 1800]}
      sizes="(max-width: 1024px) 100vw, 1024px"
    />

    {
      d.minimap && (
        <details class="mb-10 rounded-lg border border-ink-800 bg-ink-900/40 p-4">
          <summary class="cursor-pointer text-sm font-medium text-ink-200 hover:text-brand-400">
            View topdown layout
          </summary>
          <Image
            src={d.minimap}
            alt={d.minimapAlt || `${d.name} minimap`}
            class="mt-4 rounded-md w-full border border-ink-800"
            widths={[600, 1200]}
          />
        </details>
      )
    }

    <div class="prose-raid">
      <Content />
    </div>
  </article>

  <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbList)} />
</BaseLayout>
