---
import { getCollection } from "astro:content";
import { Code } from 'astro-expressive-code/components'
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import LinkButton from "@components/LinkButton.astro";
import Hr from "@components/Hr.astro";
import Card from "@components/Card";
import Socials from "@components/Socials.astro";
import getSortedPosts from "@utils/getSortedPosts";
import { SITE, SOCIALS } from "@config";
import { Image } from 'astro:assets';
import RaidMarketThumbnail from "@assets/images/thumbnails/market/RaidMarketThumbnail.png";
const posts = await getCollection("blog");

const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);

const socialCount = SOCIALS.filter(social => social.active).length;

const RAIDMaps = [ 
  {mapName : "RAID - MARKET", mapCode : "8615-7337-4501"},  
  
  ];
---

<Layout>
  <Header />
  <main id="main-content">
    <section id="hero" class="default">
      <h1>About</h1>
      <a
        target="_blank"
        href="/rss.xml"
        class="rss-link"
        aria-label="rss feed"
        title="RSS Feed"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="rss-icon"
          ><path
            d="M19 20.001C19 11.729 12.271 5 4 5v2c7.168 0 13 5.832 13 13.001h2z"
          ></path><path
            d="M12 20.001h2C14 14.486 9.514 10 4 10v2c4.411 0 8 3.589 8 8.001z"
          ></path><circle cx="6" cy="18" r="2"></circle>
        </svg>
        <span class="sr-only">RSS Feed</span>
      </a>

      <Image src={RaidMarketThumbnail} alt="RaidMarketThumbnail" width="1920" height="1080" />
      <br />

      <p>
        RAID is a fast-paced, high-competitive, tactical third-person shooter created in Fortnite. 
      </p>      
      <p>
        Visit  
        <LinkButton
          className="underline decoration-dashed underline-offset-4 hover:text-skin-accent"
          href="/learn"
        >
          Learn
        </LinkButton> to learn more about RAID game-play mechanics
      </p>
      <p>
        Visit  
        <LinkButton
          className="underline decoration-dashed underline-offset-4 hover:text-skin-accent"
          href="/maps"
        >
          Maps
        </LinkButton> to see more details about RAID maps
      </p>
      <p>
        Visit  
        <LinkButton
          className="underline decoration-dashed underline-offset-4 hover:text-skin-accent"
          href="/weapons"
        >
          Weapons
        </LinkButton> to check all available weapons in RAID
      </p>        
      
      <p>Fortnite Creator Page: <LinkButton className="underline decoration-dashed underline-offset-4 hover:text-skin-accent" href="https://www.fortnite.com/@uefnraidteam">https://www.fortnite.com/@uefnraidteam</LinkButton></p>

      <table style="width:100%" cellspacing="0" cellpadding="0">
        <tr>
          <td>Follow UEFN RAID on Socials:</td>
          <td style="width:60%"><Socials /></td>
        </tr>
      </table>      
      <br />
      <p><b>NOTE: This game is not sponsored, endorsed, or administered by Epic Games, Inc.</b></p>
    </section>

    <Hr />
    <section id="hero" class="default">
      <h1>RAID Island Codes</h1>
      <p>To look for a RAID map in Fortnite, follow these steps:</p>
      <p>- Launch Fortnite</p> 
      <p>- On the top left, select the magnifying glass icon beside the Play button</p>
      <p>- Copy one of the following RAID island codes and paste it into the Search bar</p>
      <ul>
        {RAIDMaps.map((map) => <li ><Code code={map.mapCode} lang="js" title={map.mapName} /></li>)}
      </ul>
      
    </section>   
    {
      featuredPosts.length > 0 && (
        <>
          <section id="featured" class="default">
            <h2>Featured</h2>
            <ul>
              {featuredPosts.map(({ data, slug }) => (
                <Card
                  href={`/posts/${slug}/`}
                  frontmatter={data}
                  secHeading={false}
                />
              ))}
            </ul>
          </section>
          {recentPosts.length > 0 && <Hr />}
        </>
      )
    }
    <br />    
    <Hr />
    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="default">
          <h2>Recent Posts</h2>
          <ul>
            {recentPosts.map(
              ({ data, slug }, index) =>
                index < SITE.postPerIndex && (
                  <Card
                    href={`/posts/${slug}/`}
                    frontmatter={data}
                    secHeading={false}
                  />
                )
            )}
          </ul>
        </section>
      )
    }

    <div class="all-posts-btn-wrapper">
      <LinkButton href="/posts/">
        All Posts
        <svg xmlns="http://www.w3.org/2000/svg"
          ><path
            d="m11.293 17.293 1.414 1.414L19.414 12l-6.707-6.707-1.414 1.414L15.586 11H6v2h9.586z"
          ></path>
        </svg>
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  /* ===== Hero Section ===== */
  #hero {
    @apply pb-6 pt-8;
  }
  #hero h1 {
    @apply my-4 inline-block text-3xl font-bold sm:my-8 sm:text-5xl;
  }
  #hero .rss-link {
    @apply mb-6;
  }
  #hero .rss-icon {
    @apply mb-2 h-6 w-6 scale-110 fill-skin-accent sm:mb-3 sm:scale-125;
  }
  #hero p {
    @apply my-2;
  }
  .social-wrapper {
    @apply mt-4 flex flex-col sm:flex-row sm:items-center;
  }
  .social-links {
    @apply mb-1 mr-2 whitespace-nowrap sm:mb-0;
  }

  /* ===== Featured & Recent Posts Sections ===== */
  #featured,
  #recent-posts {
    @apply pb-6 pt-12;
  }
  #featured h2,
  #recent-posts h2 {
    @apply text-2xl font-semibold tracking-wide;
  }
  .all-posts-btn-wrapper {
    @apply my-8 text-center;
  }

</style>
