---
import { SITE } from "@config";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import Footer from "@components/Footer.astro";
import Header from "@components/Header.astro";
import Layout from "layouts/Layout.astro";

const title = "Weapons";
---

<Layout title={`${title} | ${SITE.title}`}>
  <Header activeNav="weapons" />
  <Breadcrumbs />
  <main id="main-content">
    <section id="weapons" class="default prose mb-28 max-w-3xl prose-img:border-0">
      <h1 class="text-2xl tracking-wider sm:text-3xl">{title}</h1>
      
      <p>Threre are total 51 selected weapons in Raid. All of them have Uncommon rarity.</p>
    </section>
  </main>
  <Footer />
</Layout>
