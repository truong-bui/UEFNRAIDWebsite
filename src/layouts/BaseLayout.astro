---
import "@styles/global.css";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Analytics from "@components/Analytics.astro";
import SEO from "@components/SEO.astro";
import MaintenanceScreen from "@components/MaintenanceScreen.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  type?: "website" | "article";
}

const { title, description, image, noindex, type } = Astro.props;

// Build-time maintenance flag — Vite replaces __MAINTENANCE_MODE__ via define,
// then dead-code-eliminates the unused branch.
const maintenance = __MAINTENANCE_MODE__;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap"
    />
    <SEO title={title} description={description} image={image} noindex={noindex} type={type} />
    <Analytics />
  </head>
  <body class="bg-ink-950 text-ink-100 antialiased">
    {
      maintenance ? (
        <MaintenanceScreen />
      ) : (
        <>
          <Header />
          <main>
            <slot />
          </main>
          <Footer />
        </>
      )
    }
  </body>
</html>
