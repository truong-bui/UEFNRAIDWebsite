---
import { SITE } from "@config";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import Footer from "@components/Footer.astro";
import Header from "@components/Header.astro";
import Layout from "./Layout.astro";
import { Image, getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import { YouTube } from 'astro-embed';
import LinkButton from "@components/LinkButton.astro";
import { Code } from 'astro-expressive-code/components'
import ShareLinks from "@components/ShareLinks.astro";

interface Props {  
  frontmatter: {
    title: string;
    description?: string;
    trailerId?: string;
    fornitePageUrl?: string;
    raidCode?: string;
    raidGhostCode?: string;
    raidTDMCode?: string;    
    imageFolder: string;    
  };
}

const { frontmatter } = Astro.props;
// const { imageFolder } = Astro.props;
const images = import.meta.glob<{ default: ImageMetadata }>("/src/assets/images/screenshots/*/*");
const imagePaths = Object.keys(images).filter(imagePath => {
  return imagePath.startsWith(`/src/assets/images/screenshots/${frontmatter.imageFolder}/`);
});
---

<Layout title={`${frontmatter.title} | ${SITE.title}`}>
  <Header />
  <Breadcrumbs />
  <main id="main-content">
    <section id="maps" class="gallery prose mb-28 max-w-3xl prose-img:border-0">
      <h1 class="text-2xl tracking-wider sm:text-3xl">{frontmatter.title}</h1>

      {frontmatter.trailerId ? <YouTube id={frontmatter.trailerId} /> <br />: ""}
      {frontmatter.fornitePageUrl ? <p>Fortnite Island Page: <LinkButton className="underline decoration-dashed underline-offset-4 hover:text-skin-accent" href={frontmatter.fornitePageUrl}>{frontmatter.fornitePageUrl}</LinkButton></p> : ""}
      <h1 class="text-2xl tracking-wider sm:text-3xl">Island Codes</h1> <br/>
      {frontmatter.raidCode ? <Code code={frontmatter.raidCode} lang="js" title="RAID - MARKET" /> <br/> : ""}
      {frontmatter.raidGhostCode ? <Code code={frontmatter.raidGhostCode} lang="js" title="RAID:GHOST - MARKET" /> <br/> : ""}
      {frontmatter.raidTDMCode ? <Code code={frontmatter.raidTDMCode} lang="js" title="RAID:TDM - MARKET" /> <br/> : ""}

      <slot />
      <h1 class="text-2xl tracking-wider sm:text-3xl">Gallery</h1>
      <br />
      <div
        id="gallery"
        class="md:grid-cols-2 container mx-auto grid grid-cols-4 gap-1 px-1 pb-1"
      >
        {
          imagePaths.map(async imagePath => {
            let image = images[imagePath]();
            let optimizedImage = await getImage({
              src: image,
              width: 1920,
            });

            return (      
              <a
                href={optimizedImage.src}
                data-pswp-width={optimizedImage.attributes.width}
                data-pswp-height={optimizedImage.attributes.height}
                target="_blank"
                class="border-primary hover:border-secondary overflow-hidden rounded-md border-[1px]"         
              >
                <Image
                  src={image}
                  alt={"altText"}
                  height={350}                  
                  class={
                    "aspect-[3/2] w-full object-cover transition duration-300 ease-in-out hover:grayscale-0"
                  }
                />
              </a>
            );
          })
        }
      </div>
      
      <script> 
      import PhotoSwipeLightbox from "photoswipe/lightbox";
      import "photoswipe/style.css";
      document.addEventListener("astro:page-load", () => {        
        const lightbox = new PhotoSwipeLightbox({
          gallery: "#gallery",
          children: "a",
          pswpModule: () => import("photoswipe"),          
        });
        lightbox.init();
      });
      </script>
      
    </section>
    <section id="share" class="default">
      <ShareLinks />
    </section>
    <br />
  </main>
  <Footer />
</Layout>
